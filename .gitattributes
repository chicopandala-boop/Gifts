# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Source code and configuration files
*.ts text
*.tsx text
*.js text
*.mjs text
*.json text
*.html text
*.css text
*.md text
*.lock text

# Binary image and font assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.pdf binary
